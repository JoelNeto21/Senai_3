}BOTÃO FAB (FLOATING ACTION BUTTON) - APPLE DESIGN ========== */
.fab-info-button {
  position: fixed;
  bottom: var(--spacing-xl);
  right: var(--spacing-xl);
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--accent-blue);
  color: white;
  border: none;
  font-size: 1.3rem;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-info-button:hover {
  transform: scale(1.08);
  box-shadow: var(--shadow-xl);
}

.fab-info-button:active {
  transform: scale(0.96);
}

/* Efeito de pulsação sutil */
@keyframes fabMODAL - DESIGN MINIMALISTA APPLE ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fade-in 0.3s ease;
  backdrop-filter: blur(4px);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: var(--bg-primary);
  border-radius: 16px;
  padding: var(--spacing-xxl);
  max-width: 600px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: var(--shadow-xl);
  animation: slide-up 0.3s ease;
  border: 1px solid var(--border-color);
}

@keyframes slide-up {
  from {
    transform: translateY(30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-close {
  position: absolute;
  top: var(--spacing-lg);
  right: var(--spacing-lg);
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--text-tertiary);
  transition: all 0.2s ease;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}

.modal-close:hover {
  color: var(--text-primary);
  background: var(--bg-secondary);
  transform: scale(1.1);
}

.modal-content h2 {
  color: var(--text-primary);
  margin-top: 0;
  margin-bottom: var(--spacing-lg);
  font-size: 1.8rem;
  font-weight: 600;
  letter-spacing: -0.02

/* Conteúdo do modal */
.modal-content {
  background: white;
  border-radius: 12px;
  padding: 30px;
  max-wvar(--spacing-lg);
}

/* Cada item de alteração no modal */
.alteracao-item {
  padding: var(--spacing-lg);
  background: var(--bg-secondary);
  border-left: 3px solid var(--accent-blue);
  border-radius: 8px;
  transition: all 0.2s ease;
}

.alteracao-item:hover {
  background: var(--bg-primary);
  border-left-color: var(--accent-blue);
  box-shadow: var(--shadow-sm);
  transform: translateX(4px);
}

.alteracao-item h3 {
  margin: 0 0 var(--spacing-sm) 0;
  color: var(--accent-blue);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.alteracao-item p {
  margin: 0;
  color: var(--text-secondary);
  line-height: 1.6;
  font-size: 0.95rem
  color: #6b7280;
  transition: all 0.2s;
}

.modal-close:hover {
  color: #111827;
  transform: scale(1.2);
}

.modal-content h2 {
  color: #111827;
  margin-top: 0;
  margin-bottom: 20px;
  font-size: 1.8rem;
}

/* Container das alterações no modal */
.modal-alteracoes {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Cada item de alteração no modal */
.alteracao-item {
  padding: 16px;
  background: #f9fafb;
  border-left: 4px solid #4f46e5;
  border-radius: 6px;
  transition: all 0.2s;
}

.alteracao-item:hover {
  background: #f3f4f6;
  transform: translateX(4px);
}

.alteracao-item h3 {
  margin: 0 0 8px 0;
  color: #4f46e5;
  font-size: 1.1rem;
}

.alteracao-item p {
  margin: 0;
  color: #4b5563;
  line-height: 1.5;
}
